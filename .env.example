# AI Providers
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_MODE=production

# Database & Sync (Google Sheets)
YT_SHEET_ID=
REEL_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Ads Script Writer Database (MongoDB Atlas connection string)
# Deliberately MongoDB instead of Google Sheets: Sheets write-quota exhaustion hit
# Reel Factory's /api/db/save autosave in production; this engine avoids that class
# of bug entirely by writing to Mongo instead.
ADS_MONGODB_URI=

# Research Agent Providers
RESEARCH_REDDIT_ENABLED=true
RESEARCH_EVIDENCE_ENABLED=true
YOUTUBE_API_KEY=
RESEARCH_SEARCH_PROVIDER=serpapi
RESEARCH_SEARCH_API_KEY=
