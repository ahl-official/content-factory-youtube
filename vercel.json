{
  "version": 2,
  "framework": "vite",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/youtube/generate.js": {
      "maxDuration": 60
    },
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/youtube/(.*)",
      "destination": "/api/youtube/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}